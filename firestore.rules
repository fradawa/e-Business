rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Produits rules
    match /produits/{productId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Codes rules
    match /codes/{codeId} {
      // Admins can do anything
      allow read, write: if request.auth != null;

      // Public (unauthenticated) users can verify a code (get it) and update it (mark as used)
      // but they cannot list all codes, nor delete/create them.
      allow get: if true;
      allow update: if resource.data.used == false;
    }
  }
}
