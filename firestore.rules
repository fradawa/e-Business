rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null && (
        request.auth.token.email == 'sambouezechiel837@gmail.com' ||
        request.auth.token.email == 'fadilouseck9@gmail.com' ||
        request.auth.token.email == 'malangdiallo635@gmail.com'
      );
    }

    // Produits : lecture publique, modifications réservées aux administrateurs
    match /produits/{productId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Codes de jeu pour la roue
    match /codes/{codeId} {
      // Les admins ont un accès complet (lecture, création, suppression, modification)
      allow read, write: if isAdmin();

      // Les clients (non connectés) peuvent vérifier leur code unique
      allow get: if true;

      // Utilisation unique du code : seuls les champs 'used', 'prize' et 'usedAt' peuvent être modifiés,
      // 'used' doit impérativement passer à true, et 'prize' doit appartenir aux gains officiels autorisés.
      allow update: if resource.data.used == false
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['used', 'prize', 'usedAt'])
        && request.resource.data.used == true
        && request.resource.data.prize in [
          'Réduction 5%',
          'Rejoue la prochaine fois',
          'Réduction 10%',
          'Petit cadeau',
          'Réduction 15%',
          'JACKPOT — Produit offert'
        ];
    }
  }
}
