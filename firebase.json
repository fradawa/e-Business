{
  "firestore": {
    "rules": "firestore.rules"
  },
  "hosting": {
    "public": ".",
    "redirects": [
      {
        "source": "/preview.jpg",
        "destination": "/assets/images/preview.jpg",
        "type": 301
      },
      {
        "source": "/preview.png",
        "destination": "/assets/images/preview.png",
        "type": 301
      },
      {
        "source": "/logo.jpg",
        "destination": "/assets/logo/logo.jpg",
        "type": 301
      },
      {
        "source": "/logo.png",
        "destination": "/assets/logo/logo.png",
        "type": 301
      }
    ],
    "headers": [
      {
        "source": "**",
        "headers": [
          {
            "key": "X-Content-Type-Options",
            "value": "nosniff"
          },
          {
            "key": "X-Frame-Options",
            "value": "SAMEORIGIN"
          },
          {
            "key": "Referrer-Policy",
            "value": "strict-origin-when-cross-origin"
          }
        ]
      },
      {
        "source": "**/*.html",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, no-store, must-revalidate"
          }
        ]
      }
    ],
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**",
      "package.json",
      "package-lock.json",
      "serviceAccountKey.json",
      "generate-product-pages.js",
      "import-produits.js",
      "imports/**",
      "firestore.rules"
    ]
  }
}
